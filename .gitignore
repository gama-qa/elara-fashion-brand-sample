# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output and caches
/.next/
/out/
/build
next-env.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# Deployment
.vercel

# Secrets. API keys (UNSPLASH_ACCESS_KEY, PEXELS_API_KEY) live in .env.local
# and are never committed. Only a key-less .env.example may be tracked.
.env*
!.env.example
*.pem

# Image downloads awaiting verification (see CLAUDE.md, "Image assets").
# Accepted images live in public/images/ and ARE committed.
/.image-staging/

# Tests and coverage
/coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editors and local tool settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.claude/settings.local.json

# video downloads awaiting verification (accepted clips live in public/video/)
/.video-staging/
